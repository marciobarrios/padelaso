{
  "name": "padelaso",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo --cache-dir=.turbo/cache dev --filter=@padelaso/app",
    "dev:all": "turbo --cache-dir=.turbo/cache dev",
    "dev:marketing": "turbo --cache-dir=.turbo/cache dev --filter=@padelaso/marketing",
    "build": "turbo --cache-dir=.turbo/cache build",
    "lint": "turbo --cache-dir=.turbo/cache lint",
    "test": "turbo --cache-dir=.turbo/cache test",
    "test:db": "supabase test db",
    "test:integration": "pnpm --filter @padelaso/app test:integration",
    "typecheck": "turbo --cache-dir=.turbo/cache typecheck",
    "check": "turbo --cache-dir=.turbo/cache lint typecheck build test && pnpm test:db && pnpm test:integration",
    "dev:mobile": "turbo --cache-dir=.turbo/cache dev --filter=@padelaso/mobile",
    "mobile:ios": "pnpm --filter @padelaso/mobile ios",
    "mobile:android": "pnpm --filter @padelaso/mobile android"
  },
  "devDependencies": {
    "supabase": "2.117.0",
    "turbo": "^2.8.0",
    "typescript": "^5"
  }
}
