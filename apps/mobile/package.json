{
  "name": "@padelaso/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "doctor": "expo install --check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "native:generate": "expo prebuild",
    "watch:verify-project": "node scripts/verify-watch-project.cjs",
    "watch:test": "swift test"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@padelaso/domain": "workspace:*",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-dev-client": "58.0.18",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.16",
    "expo-modules-core": "58.0.30",
    "expo-router": "58.0.30",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-expo": "58.0.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
