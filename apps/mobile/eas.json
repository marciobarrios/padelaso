{
  "cli": {
    "version": "27.4.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "test": {
      "extends": "development",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "test"
      }
    },
    "test-simulator": {
      "extends": "test",
      "ios": {
        "simulator": true
      }
    }
  }
}
