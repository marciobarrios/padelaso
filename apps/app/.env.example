NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Product Vercel project only (app.padelaso.com). Leave empty locally to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload credentials; never prefix these with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# MCP is denied by default. Use the canonical deployment URL, including /api/mcp.
MCP_RESOURCE_URL=http://localhost:3000/api/mcp
MCP_ALLOWED_CLIENT_IDS=
MCP_ALLOWED_USER_IDS=
