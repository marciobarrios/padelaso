NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Product Vercel project only (app.padelaso.com). Leave empty locally to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time source-map upload credentials; never prefix these with NEXT_PUBLIC_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# MCP server (MAR-98). Both allowlists deny everyone when empty.
# Canonical public MCP URL. Required in production; elsewhere it defaults to
# this deployment's origin + /api/mcp.
MCP_RESOURCE_URL=
# Comma-separated OAuth client IDs registered in Supabase (Authentication > OAuth Apps).
MCP_ALLOWED_CLIENT_IDS=
# Comma-separated Supabase user IDs allowed during the phase 1 beta.
MCP_ALLOWED_USER_IDS=
